# UniGuard AI Deployment Environment Variables
# Smart India Hackathon 2026 (SIH26145)

# Backend Host & Port (assigned dynamically by Render/Heroku/Cloud Run)
HOST=0.0.0.0
PORT=8000
ENV=production

# SQLite Database Location (defaults to backend/uniguard.db)
DATABASE_PATH=backend/uniguard.db

# CORS Allowed Origins (comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=https://uniguard-ai.vercel.app,http://localhost:5173,http://localhost:3000

# Strictly Passive Guarantees (Hardcoded defaults; cannot be overridden to enable offensive actions)
PASSIVE_MODE=true
READ_ONLY_MONITORING=true
ACTIVE_RESPONSE_ENABLED=false
ALLOW_PACKET_INJECTION=false
ALLOW_PAYLOAD_DECRYPTION=false
